# ================================================================
# MediaLink-Downloader - Telegram Bot Configuration
# ================================================================

# Required: Telegram Bot Token obtained from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Directory where media is saved when choosing "Save to PC"
PC_DOWNLOAD_DIR=C:\Downloads

# Optional: Restrict bot usage to specific Telegram user IDs (comma-separated).
# Leave empty to allow any user to use your bot.
# You can get your Telegram User ID by messaging @userinfobot on Telegram.
# Example: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=

# Optional: Netscape-formatted cookies file for Instagram private accounts & restricted videos
# Put your exported cookies in this project directory as 'cookies.txt'
COOKIES_FILE=cookies.txt
